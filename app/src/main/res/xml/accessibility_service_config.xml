<?xml version="1.0" encoding="utf-8"?>
<!--
    Hardened build. The service exists so the island can be hosted in a TYPE_ACCESSIBILITY_OVERLAY
    window without SYSTEM_ALERT_WINDOW, and it listens for typeWindowStateChanged to learn which
    package is in the foreground (package name only). canRetrieveWindowContent is false, so this
    service cannot read the content of any window, and the assistant-answer feature that needed it
    is removed. The app declares no INTERNET permission.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />
